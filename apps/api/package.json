{
  "name": "@gt-ads/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GT-Ads API (Fastify, TypeScript)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
