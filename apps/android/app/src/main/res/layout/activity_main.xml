<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/registration_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/registration_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/registration_message_not_registered"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/registration_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/registration_label_server_url" />

                <EditText
                    android:id="@+id/server_url_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="url"
                    android:hint="@string/registration_label_server_url"
                    android:inputType="textUri"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/registration_label_code" />

                <EditText
                    android:id="@+id/registration_code_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="noExcludeDescendants"
                    android:inputType="textPassword|textNoSuggestions"
                    android:maxLines="1"
                    android:saveEnabled="false" />

                <Button
                    android:id="@+id/registration_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/registration_action_register" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/registration_registered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/registration_message_success"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/registration_label_device_id" />

                <TextView
                    android:id="@+id/registered_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/registration_label_registered_server" />

                <TextView
                    android:id="@+id/registered_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/playback_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <TextView
        android:id="@+id/playback_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="24dp"
        android:background="#FF1E1E1E"
        android:contentDescription="@string/playback_fallback_description"
        android:text="@string/playback_fallback_brand"
        android:textColor="#FFF5F5F5"
        android:textSize="48sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <gtads.device.info.InfoCardView
        android:id="@+id/info_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
