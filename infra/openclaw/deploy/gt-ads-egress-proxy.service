# GT-Ads Egress-Allowlist-Proxy: einziger Weg ins Internet fuer OpenClaw (nur CONNECT zu freigegebenen Hosts).
# Vorlage; Installation nur durch den Betreiber mit sudo (deploy/install.sh).
[Unit]
Description=GT-Ads Egress-Allowlist-Proxy (nur CONNECT zu freigegebenen Hosts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gtads-egress
Group=gtads-egress
ExecStart=/usr/bin/python3 -s -B /opt/gt-ads/egress-proxy/egress_proxy.py --listen 127.0.0.1:3128 --allowlist /etc/gt-ads/egress-allowlist.txt
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
InaccessiblePaths=/srv /home /root /etc/gt-ads/credentials /etc/gt-ads/openclaw-credentials
MemoryMax=128M
CPUQuota=25%
TasksMax=256

[Install]
WantedBy=multi-user.target
