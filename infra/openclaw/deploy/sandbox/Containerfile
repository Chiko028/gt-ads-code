# Sandbox-Image fuer den Coding-Agenten: Debian, git, Python, pytest, KEINE Secrets, laeuft als Nutzer 10001.
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates git python3 python3-pytest python3-pip \
    && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home --shell /bin/bash agent
USER 10001:10001
WORKDIR /home/agent
