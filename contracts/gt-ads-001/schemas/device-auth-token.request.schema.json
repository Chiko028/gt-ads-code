{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeviceAuthTokenRequest",
  "description": "POST /v1/device/auth/token (API-VERTRAG.md Abschnitt 3). Signiert wird die Nachricht gt-ads-auth-v1\\n<device_id>\\n<nonce> ohne abschliessenden Umbruch; Signatur als Base64 des ASN.1-DER-ECDSA-Werts (P-256/SHA-256).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "nonce",
    "signature"
  ],
  "properties": {
    "device_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "signature": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
